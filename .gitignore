*.sqlite-wal
*.db
*.pem
*.key
*.pfx
.env
.env.*

# ---------- 第三方二进制（体积大 + 版权，一律不进仓库）----------
usb/_internal/
usb/codex/codex.exe
usb/codex/codex-resources/
usb/codex/codex-path/
usb/node/
usb/web/
usb/python/
usb/tools/
node_modules/

# ---------- 装配 / 构建残留 ----------
